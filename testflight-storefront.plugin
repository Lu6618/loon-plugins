#!name=TestFlight 美区登录按国区下载
#!desc=登录为美区时，将 TestFlight 接口返回的 storefrontId 改写为国区（143465），按国区下载。需开启 MITM（testflight.apple.com）。
#!author=改编自 Egern 模块（来源 t.me/Aa28413761/324），方向互换：原版是国区登录改美区，本版是美区登录改国区

[Rewrite]
# TestFlight v2 接口：把响应正文里的 storefrontId 改成国区 143465（后缀 -19,29 与原版保持一致）
# 匹配写法兼容两种返回值：字符串 "143441-1,29" 或纯数字 143441
# 覆盖全部 /v2/accounts/ 接口，不只 install：地区校验可能发生在应用详情、接受邀请等别的接口
^https:\/\/testflight\.apple\.com\/v2\/accounts\/.*$ url response-body "storefrontId"\s*:\s*("[^"]*"|\d+) "storefrontId":"143465-19,29"

[MITM]
hostname = testflight.apple.com
