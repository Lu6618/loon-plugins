#!name=Erosion 国行 Apple 智能与来电询问分流 [测试特性]
#!desc=由 Erosion 生成：保持国行 Siri 与普通话询问来电原因 (guzzoni) 真实 IP 直连，同时将 Apple Intelligence 隐私云计算、区域定位校验与视觉智能置顶分流至 人工智能。
#!category=Erosion

[General]
skip-proxy = %APPEND% guzzoni.apple.com
always-real-ip = %APPEND% guzzoni.apple.com, *.guzzoni.apple.com, *.siri.apple.com

[Rule]
# 1. 国行 Siri 语音主网关与普通话来电询问必须真实 IP 直连（严禁走代理）
DOMAIN-SUFFIX,guzzoni.apple.com,DIRECT
DOMAIN-SUFFIX,siri.apple.com,DIRECT
DOMAIN,dejavu.apple.com,DIRECT
DOMAIN,sequoia.apple.com,DIRECT
DOMAIN-SUFFIX,smoot.apple.com,DIRECT

# 2. Apple Intelligence 区域定位校验、PCC 隐私计算中继与匿名令牌签发（请使用支持 UDP/QUIC 的低并发干净美区节点）
DOMAIN,gspe1-ssl.ls.apple.com,人工智能
DOMAIN-SUFFIX,issuer.apple.com,人工智能
DOMAIN-SUFFIX,ropes.apple.com,人工智能
DOMAIN,mask-api.icloud.com,人工智能
DOMAIN,mask.icloud.com,人工智能
DOMAIN,mask-h2.icloud.com,人工智能
DOMAIN-SUFFIX,app.apple.com,人工智能
DOMAIN-SUFFIX,apple-relay.apple.com,人工智能
DOMAIN-SUFFIX,apple-relay.cloudflare.com,人工智能
DOMAIN-SUFFIX,apple-relay.fastly-edge.com,人工智能
DOMAIN-SUFFIX,apple-relay.akamaized.net,人工智能
DOMAIN-SUFFIX,cp4.cloudflare.com,人工智能

# 3. Siri ChatGPT 扩展与视觉智能（提问 + Google 识图）
DOMAIN-SUFFIX,openai.com,人工智能
DOMAIN-SUFFIX,chatgpt.com,人工智能
DOMAIN-SUFFIX,sora.com,人工智能
DOMAIN-SUFFIX,oaistatic.com,人工智能
DOMAIN-SUFFIX,oaiusercontent.com,人工智能
DOMAIN-SUFFIX,chatgpt.livekit.cloud,人工智能
DOMAIN,lens.google.com,人工智能
DOMAIN-SUFFIX,gemini.google.com,人工智能
DOMAIN,gemini.gstatic.com,人工智能
DOMAIN,generativelanguage.googleapis.com,人工智能
DOMAIN-SUFFIX,anthropic.com,人工智能
DOMAIN-SUFFIX,claude.ai,人工智能
DOMAIN-SUFFIX,claudeusercontent.com,人工智能